# --- Core ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Neon/Postgres) ---
# Local: postgresql://user:password@localhost:5432/cookie_crumbs
DATABASE_URL=postgresql://user:password@localhost:5432/cookie_crumbs

# --- Auth (Clerk) ---
# From https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Sign-in / Sign-up URLs (relative paths or absolute)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Webhook verification secret
CLERK_WEBHOOK_SECRET=whsec_xxx

# --- Payments (Stripe) ---
# From https://dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Media (Cloudinary) ---
# From https://cloudinary.com/console → Dashboard
CLOUDINARY_CLOUD_NAME=cookie-and-crumbs
CLOUDINARY_API_KEY=1234567890
CLOUDINARY_API_SECRET=xxx
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=cookie-and-crumbs

# --- Search (Algolia) ---
# From https://dashboard.algolia.com → API Keys
ALGOLIA_APP_ID=XXXXXX
ALGOLIA_API_KEY=admin_xxx
NEXT_PUBLIC_ALGOLIA_APP_ID=XXXXXX
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=search_only_xxx

# --- Email (Resend) ---
RESEND_API_KEY=re_xxx
EMAIL_FROM=Cookie & Crumbs <orders@cookieandcrumbs.com>

# --- Observability ---
SENTRY_DSN=https://xxx@o123.ingest.sentry.io/456